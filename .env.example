# Keep credentials here locally; this file shows the contract only.
OPENAI_API_KEY=
# Real TP-Link camera discovered at 192.0.2.20; use its camera account.
CAMERA_URL=rtsp://USERNAME:PASSWORD@192.0.2.20:554/stream2
# Alternative for cameras with a real JPEG snapshot endpoint:
# CAMERA_SNAPSHOT_URL=http://camera-address/snapshot.jpg
LIVE_VOICE=cinder
VISION_MODEL=gpt-6-luna
PORT=3031
SCENE_INTERVAL_MS=12000
# Hard cap on one paid Live session (default and maximum 1800 = 30 minutes; ~$3/hour while open).
SESSION_LIMIT_SECONDS=1800
# Optional: read an existing private env file (values here take precedence).
# OPENAI_ENV_FILE=/absolute/path/to/private.env

# For direct LAN access, set both on the server:
# BIND_HOST=0.0.0.0
# PUBLIC_ORIGIN=http://192.0.2.10:3031

# Standalone Linux deployment: remote webpage monitors controls; audio stays on server.
AUDIO_MODE=linux
AUTO_START=true
AUTO_TRACK=true
# Current outdoor mount is upright; logical-up velocity decreases reported tilt.
CAMERA_ROTATE=0
PTZ_INVERT_TILT=false
# ONVIF_URL=http://camera-address:2020/onvif/device_service
# ONVIF_USERNAME=your-camera-account
# ONVIF_PASSWORD=your-camera-password
# PTZ_HOME_PAN=recorded-safe-pan
# PTZ_HOME_TILT=recorded-safe-tilt
ABSENCE_CLOSE_MS=30000
# Calibrate reported ONVIF position independently of velocity inversion: +1 or -1.
PTZ_POSITION_PAN_DIRECTION=1
PTZ_POSITION_TILT_DIRECTION=-1

# Private saved waiting angle; used after a voice session ends.
CAMERA_HOME_FILE=data/camera-home.json
PREVIEW_FPS=6

# Spoken debug mode: never starts GPT-Live; speaks each Judge event ("New party approaching, 2 people.") via spd-say.
DEBUG_SPEAK=false

# Judge read log (PRIVATE: real camera images + labels; gitignored, dirs 0700, files 0600). Review at /review.html.
JUDGE_LOG=true
# JUDGE_LOG_DIR=data/judge-log
JUDGE_LOG_MAX_ENTRIES=5000

# App mode: OFF | ON | DATA_CAPTURE. Daily schedule (local wall clock, DST-safe; gaps are OFF). Default when unset on `npm start`:
#   08:00-09:00 ON, 09:00-15:00 DATA_CAPTURE, 15:00-22:00 ON, otherwise OFF
# MODE_SCHEDULE=08:00-09:00=ON,09:00-15:00=DATA_CAPTURE,15:00-22:00=ON
# MODE_SCHEDULE=off      # disable the schedule; then START_MODE / AUTO_START=true (ON) pick the boot mode
MODE_TZ=America/Los_Angeles
# START_MODE=OFF
# Milliseconds to let the goodbye prompt play before Live is closed on a mode change (default 8000).
# MODE_GOODBYE_MS=8000

# Replayable capture store (PRIVATE: real camera images, possibly children; gitignored; dirs 0700, files 0600).
# Records clips while the mode is DATA_CAPTURE (and in ON when CAPTURE_IN_ON=true).
# CAPTURE_DIR=data/captures
# Presence-only sampling: a frame is saved only when that capture's Presence read is >= 1 or uncertain, at most one per interval.
# CAPTURE_INTERVAL_MS=2000
# Capture frames at the camera's NATIVE resolution (second ffmpeg output while capturing; preview/live judges stay at JUDGE_WIDTH).
# CAPTURE_NATIVE=true
# CAPTURE_NATIVE_QUALITY=3          # ffmpeg -q:v for native frames (2 = best, larger = smaller files)
# Native frames are big (roughly 0.5-1 MB each at 2560x1440). Default cap is 6 GB with native capture, 5 GB without.
# CAPTURE_MAX_GB=6
# Stop recording (and report an error in /api/status) when free disk on the capture volume drops below this.
# CAPTURE_MIN_FREE_GB=3
# Width of the shared preview/Judge frame stream in pixels (default 960). Changing it changes what the live judges see.
# JUDGE_WIDTH=960
# CAPTURE_IN_ON=false


# Person detector (local YOLOX sidecar; always on except app mode OFF; see DEPLOYMENT.md "Person detector")
# DETECTOR=off                      # disable the detector completely
# PRESENCE_RESOLVER=primary          # primary (default: YOLO + zones are the presence source; Judge only does costume/motion on PATH; Judge presence is the fallback when the detector is down/stale) | tiebreak | judge
# DETECTOR_MODE=shadow              # shadow = tiebreak (old default) | primary | off
# DETECTOR_PRESENCE_SCORE=0.5       # score cutoff for presence decisions (DETECTOR_MIN_SCORE stays the raw sidecar cutoff)
# DETECTOR_STALE_MS=3000            # no detector frame for this long => Judge presence fallback
# PRIMARY_READ_MS=1000              # decision cadence while the detector drives presence
# GROUP_ENTER_MS_SIDEWALK=1000 GROUP_ENTER_MS_PATH=750 GROUP_EXIT_MS=3000 GROUP_PATH_EXIT_MS=1500 TRACK_HOLD_MS=1000 ZONE_MARGIN=0.02   # time debounce of the detector group state
# JUDGE_LOG_DETECTOR_MS=2000        # at most one detector-only judge-log entry per this many ms (people present only)
# DETECTOR_FPS=4                    # frames per second taken from the live stream (drops frames while busy)
# DETECTOR_MIN_SCORE=0.25           # sidecar floor; 0.25-0.5 boxes only bridge occluded tracks, never count
# DETECTOR_SIZE=416                 # model input size (multiple of 32; 416 for tiny/nano)
# DETECTOR_THREADS=2                # OpenCV threads for the sidecar (0 = auto)
# DETECTOR_MODEL=models/yolox_tiny.onnx
# DETECTOR_PYTHON=detector/.venv/bin/python
# DETECTOR_STATIC_MIN=10            # minutes an unmoving box becomes a prop (0 disables)
# DETECTOR_STATIC_IOU=0.8           # "has not moved" threshold
# DETECTOR_ZONES_FILE=data/detector-zones.json   # falls back to detector/zones.default.json
# Sidewalk scream (src/presence/scream.mjs): clips rendered once by `node scripts/scream/generate.mjs` into data/screams/.
SCREAM=on
SCREAM_COOLDOWN_MS=30000
SCREAM_VOLUME=1
